{
	return a;
}

unsigned int *f1_uint(void)
{
	return NULL;
}

unsigned int **f2_uint(void)
{
	return NULL;
}

long f0_long(long a, long *b, long **c)
{
	return a;
}

long *f1_long(void)
{
	return NULL;
}

long **f2_long(void)
{
	return NULL;
}

unsigned long f0_ulong(unsigned long a, unsigned long *b, unsigned long **c)
{
	return a;
}

unsigned long *f1_ulong(void)
{
	return NULL;
}

unsigned long **f2_ulong(void)
{
	return NULL;
}

float f0_float(float a, float *b, float **c)
{
	return a;
}

float *f1_float(void)
{
	return NULL;
}

float **f2_float(void)
{
	return NULL;
