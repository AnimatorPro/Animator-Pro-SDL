char output[64];
char expected[16];
char path[128];
char device[16];
char directory[64];
char filename[32];
char suffix[16];
char merged[128];

main()
{
	void *memory;
	FILE *file;

	puts("poco standard catalog");
	if (sqrt(81.0) != 9.0)
		return 1;
	if (snprintf(output, 64, "%s-%d", "catalog", 7) != 9 ||
		strcmp(output, "catalog-7") != 0)
		return 2;
	memory = malloc(16);
	if (memory == NULL)
		return 3;
	memset(memory, 'A', 16);
	memset(expected, 'A', 16);
	if (memcmp(memory, expected, 16) != 0)
		return 4;
	/* Leave this allocation outstanding: the standard memory library owns it
	 * and must release it when this program finishes. */
	strcpy(path, "C:/Poco/catalog.poc");
	if (fnsplit(path, device, directory, filename, suffix) != 0 ||
		strcmp(device, "C:") != 0 || strcmp(directory, "/Poco/") != 0 ||
		strcmp(filename, "catalog") != 0 || strcmp(suffix, ".poc") != 0 ||
		fnmerge(merged, device, directory, filename, suffix) != 0 ||
		strcmp(path, merged) != 0)
		return 5;
	file = fopen("poco-standard-catalog-success.txt", "w");
	if (file == NULL || fputs("success", file) < 0)
		return 6;
	return 0;
}
